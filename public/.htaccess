# BIWORKSPACE — Apache config for cPanel hosting at https://bicomworkspace.com
# Vite copies everything in public/ into dist/, so this ships with the build.
# Mirrors the rules vercel.json applied on Vercel.
#
# Rule ORDER matters: redirects must run before the SPA catch-all, because
# that rule ends processing with [L] and would otherwise swallow them.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ------------------------------------------------------------------
  # 1. Leave certificate / domain-verification files alone.
  #    AutoSSL (Let's Encrypt) and email-provider checks read these; if
  #    they were rewritten to index.html, SSL renewal would silently fail.
  # ------------------------------------------------------------------
  RewriteRule ^\.well-known/ - [L]

  # ------------------------------------------------------------------
  # 2. One canonical origin: https://bicomworkspace.com
  #    The API's CORS allow-list and the auth cookie are tied to an exact
  #    origin, so www and plain http must redirect here rather than serve
  #    a second copy of the app. Auth also needs HTTPS: the session cookie
  #    is SameSite=None; Secure and cannot survive plain HTTP.
  # ------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ------------------------------------------------------------------
  # 3. SPA routing: React Router owns the URL. Without this, refreshing on
  #    /inbox or /projects/123 asks Apache for a file that does not exist
  #    and returns a 404.
  # ------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule . /index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# Caching: hashed asset filenames change on every build, so they can be
# cached forever. index.html must never be cached, or users keep running
# the previous release after a deploy.
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"

  <FilesMatch "\.(js|mjs|css|woff2?|ttf|eot|png|jpe?g|gif|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^(index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# Compression — Vite ships large JS chunks; this cuts transfer noticeably.
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
